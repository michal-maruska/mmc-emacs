;; generic functions not included in emacs
(defun join-string(xs &optional sep)
  (cond ((null xs) "")
	((null (cdr xs)) (car xs))
	(t (concat (car xs) (or sep " ") (join-string (cdr xs) sep)))))



(defun compose-path (&rest segments)
  ""
  (join-string
   segments "/"))

