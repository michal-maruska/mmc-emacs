;;;  resizing/reducing frame:
(defun reduce-frame-to-max-text-width ()
  "reduce the current frame to the width of longest line of the current buffer"
  (interactive)
  (let ((max-width 10))			; this is the minimum, we don't try less
    (map-lines (point-min)
	       (point-max)
	       (lambda (end-line)
		 (let ((l (- end-line (point))))
		   (if (> l max-width)
		       (setq max-width l)))))
    (set-frame-width (selected-frame) (1+ max-width))))


