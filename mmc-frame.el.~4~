;; fixme:  current display !!  just :0
(defun kill-frames-on-display (display)
  ""
  (interactive
   (let ((displays (unique
		    (sort (mapcar
			   (lambda (item)
			     (frame-parameter item 'display))
			   (frame-list)) 'string<)))
	 def (prompt "kill frames on: "))
     (list (read-display prompt def displays))))
  (let* ((regexp (regexp-quote display))
	 (frames
	  ;; frames on the DISPLAY:
	  (mapcar-nonil
	   (lambda (item)
	     (let ((display (frame-parameter item 'display)))
	       (if (string-match regexp display)
		   item nil)))
	   (frame-list))))
    (mapcar
     (lambda (item)
       (delete-frame item))
     frames)))

(define-key ctl-x-5-map "k" 'kill-frames-on-display)


(defun list-frames ()
  ""
  (interactive)
  (with-output-to-temp-buffer "*frames*"
    (mapcar
     (lambda (item)
       (princ (frame-parameter item 'outer-window-id))
       (princ "\t")
       (princ (frame-parameter item 'display))
       (princ "\t")
       (princ (frame-parameter item 'name))
       (terpri))
     (frame-list))))



(defun how-many-displays()
  "return the number of X displays, on which we have frames"
  (let ((displays '())
        )
    (mapcar
     (lambda (item)
       (let ((display (frame-parameter item 'display))
             )
         (unless (member display displays)
           (setq  displays (cons display displays)))))
     (frame-list))
    (length displays)))
