(defun isearch-reset()
  (interactive)
  (setq isearch-level 0)
  (set-face-background 'cursor "green"))


;;; sometimes i  C-w (believing i'm in isearch, and lose the region, b/c i' *not*).
;;  So i make the cursor color change, and indicate  isearch-mode.
(unless running-xemacs
  (defvar isearch-mode-hook-cursor-background nil "")
  (defvar isearch-level 0 "")           ;(setq isearch-level 0)
  (add-hook 'isearch-mode-hook
    (lambda ()

      (if (zerop isearch-level)
          ;; Save: 
          (setq isearch-mode-hook-cursor-background
                (face-background 'cursor)))

      (setq isearch-level (1+ isearch-level))
      (set-face-background 'cursor "red")))

  ;; (set-face-background 'cursor "green")
  ;; (setq isearch-mode-hook-cursor-background "green")
                                        ;isearch-mode-hook
                                        ;isearch-mode-end-hook
  (add-hook 'isearch-mode-end-hook
    ;; What if C-g ? is this run only once ?
    (lambda ()
      (setq isearch-level (1- isearch-level))
      (if (zerop isearch-level)
          (set-face-background 'cursor isearch-mode-hook-cursor-background)))))






;; grossjohann
(defun isearch-occur ()
  "Run `occur' with current isearch string."
  (interactive)
  (let ((case-fold-search isearch-case-fold-search)
        (search-string (if isearch-regexp
                           isearch-string
                         (regexp-quote isearch-string))))
    (occur search-string)))

(define-key isearch-mode-map [(control o)] 'isearch-occur)
