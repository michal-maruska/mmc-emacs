;; fixme: Should return 't  if killed!
(defun de-context-kill (buffer arg)
   "Kill buffer, taking gnuclient into account."
   (interactive (list (current-buffer)
                      (prefix-numeric-value
                       current-prefix-arg)))
   (when (and (buffer-modified-p buffer)
              buffer-file-name
              (not (string-match "\\*.*\\*" (buffer-name buffer)))
              ;; erc buffers will be automatically saved
              
              (not (eq (with-current-buffer buffer
                         major-mode) 'erc-mode)) ;fixme!
              (= 1 arg))
     (let ((differences 't))
       (when (file-exists-p buffer-file-name)
         (setq differences (with-current-buffer buffer
                             (diff-buffer-with-associated-file)))) ;fixme!
       (let ((debug-on-error nil))
         (error (if differences
                    (if (file-exists-p buffer-file-name)
                        "Buffer has unsaved changes"
                      "The file of the buffer was removed!")
                  "Buffer has unsaved changes, but no differences wrt the file")))))
   (if (and (boundp 'gnuserv-minor-mode)
            (with-current-buffer buffer
              gnuserv-minor-mode))
       ;; fixme?
       (gnuserv-edit)
     (with-current-buffer buffer
         (set-buffer-modified-p nil))
     (kill-buffer buffer)))



