;; fixme skeleton w/ params ?

(defun name-of-the-major-mode (mode)
  ""
  (let ((name (symbol-name mode)))
    (and name
	 (string-match  "^\\(.*\\)-mode$" name)
	 (match-string 1 name))))

;(name-of-the-major-mode 'tex-mode)

(define-skeleton mode-header-skeleton
  ""
  ;; read 
  (name-of-the-major-mode (read-mode-symbol))
  "-*-" str "-*-")

;; todo:
;;  - group the undo information
;;  - select the mode & insert the comment-start
(defun mode-header ()
  "insert the -*- -*- header at the beginning of the buffer (narrowing ??) ."
  (interactive)
  (save-excursion
    (beginning-of-buffer)
    (let (done)
    (unwind-protect
	(progn
	  (undo-boundary)
	  (insert (or comment-start ""))
	  (call-interactively 'mode-header-skeleton)
	  (setq done 't))
      (unless done
	(undo))))))


(let ((map my-global-keymap));; insert-keymap
  (define-key map "M" 'mode-header))

